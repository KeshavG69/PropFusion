# MongoDB Configuration (REQUIRED for PropertyMongoClient with user_id/session_id)
# MongoDB connection string - get from MongoDB Atlas or your local installation
# Example for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/
# Example for local: mongodb://localhost:27017/
MONGODB_URI=your_mongodb_connection_string_here

# MongoDB Database Name
MONGODB_DB_NAME=property_search
